# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real credentials.

# Your Unison brain API key (obtain via `POST /v1/auth/provision` or the dashboard)
UNISON_TOKEN=usk_live_...

# Base URL for the Unison brain API (defaults to https://api.unisonlabs.ai)
# Override for local dev: UNISON_API_URL=http://localhost:4001
UNISON_API_URL=https://api.unisonlabs.ai
